ZGLAB_RAG_ENV=production
ZGLAB_RAG_HOST=127.0.0.1
ZGLAB_RAG_PORT=8000
ZGLAB_RAG_LOG_LEVEL=INFO

ZGLAB_RAG_DATA_DIR=/opt/zglab-rag/runtime
ZGLAB_RAG_DATABASE_PATH=/opt/zglab-rag/runtime/knowledge.db
ZGLAB_RAG_BACKUP_DIR=/opt/zglab-rag/runtime/backups
ZGLAB_RAG_BACKUP_RETAIN_COUNT=7
ZGLAB_RAG_SOURCES_CONFIG=/opt/zglab-rag/app/config/sources.yaml
ZGLAB_RAG_SOURCE_CHECKOUT_ROOT=/opt/zglab-rag/sources
ZGLAB_RAG_DEFAULT_VISIBILITY=public

ZGLAB_RAG_LLM_BASE_URL=
ZGLAB_RAG_LLM_API_KEY=
ZGLAB_RAG_LLM_MODEL=
ZGLAB_RAG_LLM_TIMEOUT_SECONDS=60

ZGLAB_RAG_GENERATION_RETRIEVAL_TOP_K=5
ZGLAB_RAG_GENERATION_MAX_EVIDENCE_ITEMS=5
ZGLAB_RAG_GENERATION_MAX_CONTEXT_CHARS=6000

ZGLAB_RAG_API_QUESTION_MIN_LENGTH=1
ZGLAB_RAG_API_QUESTION_MAX_LENGTH=1000
ZGLAB_RAG_API_REQUEST_TIMEOUT_SECONDS=90
ZGLAB_RAG_API_MAX_CONCURRENT_REQUESTS=1
ZGLAB_RAG_API_RATE_LIMIT_REQUESTS=10
ZGLAB_RAG_API_RATE_LIMIT_WINDOW_SECONDS=60
ZGLAB_RAG_API_MAX_REQUEST_BODY_BYTES=16384
ZGLAB_RAG_API_CORS_ORIGINS=["https://ask.zglab.fun"]
ZGLAB_RAG_API_TRUSTED_PROXY_IPS=["127.0.0.1","::1"]
ZGLAB_RAG_API_SSE_HEARTBEAT_SECONDS=15

# Phase 11: anonymous v1 ask endpoints return 410 Gone after migration.
# 生产强制项：env=production 未置位 true 时启动校验直接拒绝启动（fail-closed）。
ZGLAB_RAG_API_V1_RETIRED=true

# Phase 11 Authentication & Access Control
ZGLAB_RAG_AUTH_DATABASE_PATH=/opt/zglab-rag/runtime/auth.db
ZGLAB_RAG_AUTH_PUBLIC_BASE_URL=https://ask.zglab.fun
ZGLAB_RAG_AUTH_ALLOWED_ORIGINS=["https://ask.zglab.fun"]
# __Host- cookie: Secure + Path=/ + host-only（生产 HTTPS 下保持 true）
ZGLAB_RAG_AUTH_COOKIE_NAME=__Host-zglab_session
ZGLAB_RAG_AUTH_COOKIE_SECURE=true
ZGLAB_RAG_AUTH_SESSION_IDLE_TIMEOUT_HOURS=168
ZGLAB_RAG_AUTH_SESSION_ABSOLUTE_TIMEOUT_HOURS=720
ZGLAB_RAG_AUTH_ACTIVATION_TOKEN_HOURS=24
ZGLAB_RAG_AUTH_RESET_TOKEN_HOURS=24
ZGLAB_RAG_AUTH_PASSWORD_MIN_LENGTH=12
ZGLAB_RAG_AUTH_PASSWORD_MAX_LENGTH=128
ZGLAB_RAG_AUTH_LOGIN_PER_IP_ATTEMPTS=10
ZGLAB_RAG_AUTH_LOGIN_PER_IP_WINDOW_SECONDS=600
ZGLAB_RAG_AUTH_LOGIN_PER_USERNAME_ATTEMPTS=5
ZGLAB_RAG_AUTH_LOGIN_PER_USERNAME_WINDOW_SECONDS=900
ZGLAB_RAG_AUTH_USER_REQUESTS_PER_MINUTE=10
ZGLAB_RAG_AUTH_USER_REQUESTS_PER_DAY=100

# LLM kill switch：false 时 landing/login/auth 正常，ask 返回 SERVICE_DISABLED
ZGLAB_RAG_LLM_ENABLED=true

# Phase 12B Web Research Core（fail-closed）。
# 生产保持 false 直到 Phase 12D 产品验收；Search API Key 只经环境变量注入，
# 严禁写入代码 / 文档 / 日志 / Git。预算按 2 vCPU / 2 GiB 保守配置。
ZGLAB_RAG_WEB_RESEARCH_ENABLED=false
ZGLAB_RAG_SEARCH_PROVIDER=tavily
ZGLAB_RAG_SEARCH_API_KEY=
ZGLAB_RAG_RESEARCH_MAX_SEARCH_RESULTS=6
ZGLAB_RAG_RESEARCH_MAX_FETCH_CANDIDATES=4
ZGLAB_RAG_RESEARCH_MAX_REDIRECTS=3
ZGLAB_RAG_RESEARCH_FETCH_TIMEOUT_SECONDS=8
ZGLAB_RAG_RESEARCH_OVERALL_TIMEOUT_SECONDS=30
ZGLAB_RAG_RESEARCH_MAX_RESPONSE_BYTES=1572864
ZGLAB_RAG_RESEARCH_MAX_EXTRACTED_CHARS=8000

# Phase 12D 产品成本边界：web research 独立 quota bucket（不与普通 ask 共用）、
# 保守并发（单实例 2 vCPU / 2 GiB）与服务端权限策略。
ZGLAB_RAG_WEB_RESEARCH_REQUESTS_PER_MINUTE=3
ZGLAB_RAG_WEB_RESEARCH_REQUESTS_PER_DAY=20
ZGLAB_RAG_WEB_RESEARCH_CONCURRENCY=1
ZGLAB_RAG_WEB_RESEARCH_ADMIN_ONLY=false

# Phase 14D: start OFF; enable only after authenticated production smoke.
ZGLAB_RAG_AGENT_ENABLED=false
ZGLAB_RAG_AGENT_REQUESTS_PER_MINUTE=2
ZGLAB_RAG_AGENT_REQUESTS_PER_DAY=10
ZGLAB_RAG_AGENT_CONCURRENCY=1
ZGLAB_RAG_AGENT_OVERALL_DEADLINE_SECONDS=60

# 直连 Hugging Face 不可用时，服务单元会使用该镜像下载模型。
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_OFFLINE=1
