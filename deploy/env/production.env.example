ZGLAB_RAG_ENV=production
ZGLAB_RAG_HOST=127.0.0.1
ZGLAB_RAG_PORT=8000
ZGLAB_RAG_LOG_LEVEL=INFO

ZGLAB_RAG_DATA_DIR=/opt/zglab-rag/runtime
ZGLAB_RAG_DATABASE_PATH=/opt/zglab-rag/runtime/knowledge.db
ZGLAB_RAG_BACKUP_DIR=/opt/zglab-rag/runtime/backups
ZGLAB_RAG_BACKUP_RETAIN_COUNT=7
ZGLAB_RAG_SOURCES_CONFIG=/opt/zglab-rag/app/config/sources.yaml
ZGLAB_RAG_DEFAULT_VISIBILITY=public

ZGLAB_RAG_LLM_BASE_URL=
ZGLAB_RAG_LLM_API_KEY=
ZGLAB_RAG_LLM_MODEL=
ZGLAB_RAG_LLM_TIMEOUT_SECONDS=60

ZGLAB_RAG_GENERATION_RETRIEVAL_TOP_K=5
ZGLAB_RAG_GENERATION_MAX_EVIDENCE_ITEMS=5
ZGLAB_RAG_GENERATION_MAX_CONTEXT_CHARS=6000

ZGLAB_RAG_API_QUESTION_MIN_LENGTH=1
ZGLAB_RAG_API_QUESTION_MAX_LENGTH=1000
ZGLAB_RAG_API_REQUEST_TIMEOUT_SECONDS=90
ZGLAB_RAG_API_MAX_CONCURRENT_REQUESTS=1
ZGLAB_RAG_API_RATE_LIMIT_REQUESTS=10
ZGLAB_RAG_API_RATE_LIMIT_WINDOW_SECONDS=60
ZGLAB_RAG_API_MAX_REQUEST_BODY_BYTES=16384
ZGLAB_RAG_API_CORS_ORIGINS=["https://ask.zglab.fun"]
ZGLAB_RAG_API_TRUSTED_PROXY_IPS=["127.0.0.1","::1"]
ZGLAB_RAG_API_SSE_HEARTBEAT_SECONDS=15

# 直连 Hugging Face 不可用时，服务单元会使用该镜像下载模型。
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_OFFLINE=1
