# Application
ZGLAB_RAG_ENV=development
ZGLAB_RAG_HOST=127.0.0.1
ZGLAB_RAG_PORT=8000
ZGLAB_RAG_LOG_LEVEL=INFO

# Paths
ZGLAB_RAG_DATA_DIR=runtime
ZGLAB_RAG_DATABASE_PATH=runtime/knowledge.db
ZGLAB_RAG_BACKUP_DIR=runtime/backups
ZGLAB_RAG_BACKUP_RETAIN_COUNT=7
ZGLAB_RAG_SOURCES_CONFIG=config/sources.yaml

# Public retrieval is the only supported mode in v0/v1.
ZGLAB_RAG_DEFAULT_VISIBILITY=public

# Markdown chunking (character-equivalent length)
ZGLAB_RAG_CHUNK_TARGET_SIZE=700
ZGLAB_RAG_CHUNK_MAX_SIZE=1200
ZGLAB_RAG_CHUNK_OVERLAP=120

# LLM provider for grounded generation (OpenAI-compatible endpoint).
# Keep real secrets in .env only; never commit them.
ZGLAB_RAG_LLM_BASE_URL=
ZGLAB_RAG_LLM_API_KEY=
ZGLAB_RAG_LLM_MODEL=
ZGLAB_RAG_LLM_TIMEOUT_SECONDS=60

# Grounded generation context budget
ZGLAB_RAG_GENERATION_RETRIEVAL_TOP_K=5
ZGLAB_RAG_GENERATION_MAX_EVIDENCE_ITEMS=5
ZGLAB_RAG_GENERATION_MAX_CONTEXT_CHARS=6000

# Phase 9A Public API configuration
ZGLAB_RAG_API_QUESTION_MIN_LENGTH=1
ZGLAB_RAG_API_QUESTION_MAX_LENGTH=1000
ZGLAB_RAG_API_REQUEST_TIMEOUT_SECONDS=90
ZGLAB_RAG_API_MAX_CONCURRENT_REQUESTS=1
ZGLAB_RAG_API_RATE_LIMIT_REQUESTS=10
ZGLAB_RAG_API_RATE_LIMIT_WINDOW_SECONDS=60
ZGLAB_RAG_API_MAX_REQUEST_BODY_BYTES=16384
# CORS origins as JSON array; production domain to be set in Phase 10
ZGLAB_RAG_API_CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
ZGLAB_RAG_API_TRUSTED_PROXY_IPS=["127.0.0.1","::1"]
# Phase 9B: SSE heartbeat interval (seconds)
ZGLAB_RAG_API_SSE_HEARTBEAT_SECONDS=15
# Phase 11: retire anonymous v1 ask endpoints (production migration flips this)
ZGLAB_RAG_API_V1_RETIRED=false

# Phase 11 Authentication & Access Control
ZGLAB_RAG_AUTH_DATABASE_PATH=runtime/auth.db
ZGLAB_RAG_AUTH_PUBLIC_BASE_URL=http://localhost:8000
# 本地纯 HTTP 开发时 Secure/__Host- cookie 无法写入浏览器，可改为：
#   ZGLAB_RAG_AUTH_COOKIE_NAME=zglab_session_dev
#   ZGLAB_RAG_AUTH_COOKIE_SECURE=false
# 生产 HTTPS 必须保持 __Host-zglab_session + true。
ZGLAB_RAG_AUTH_COOKIE_NAME=__Host-zglab_session
ZGLAB_RAG_AUTH_COOKIE_SECURE=true
ZGLAB_RAG_LLM_ENABLED=true

# Embedding / reranker selection is intentionally not frozen in v0.
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
RERANKER_PROVIDER=
RERANKER_MODEL=
