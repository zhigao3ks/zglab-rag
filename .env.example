# Application
ZGLAB_RAG_ENV=development
ZGLAB_RAG_HOST=127.0.0.1
ZGLAB_RAG_PORT=8000
ZGLAB_RAG_LOG_LEVEL=INFO

# Paths
ZGLAB_RAG_DATA_DIR=runtime
ZGLAB_RAG_SOURCES_CONFIG=config/sources.yaml

# Public retrieval is the only supported mode in v0/v1.
ZGLAB_RAG_DEFAULT_VISIBILITY=public

# LLM provider (reserved for generation stage; keep real secrets in .env only)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Embedding / reranker selection is intentionally not frozen in v0.
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
RERANKER_PROVIDER=
RERANKER_MODEL=
