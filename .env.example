# Application
ZGLAB_RAG_ENV=development
ZGLAB_RAG_HOST=127.0.0.1
ZGLAB_RAG_PORT=8000
ZGLAB_RAG_LOG_LEVEL=INFO

# Paths
ZGLAB_RAG_DATA_DIR=runtime
ZGLAB_RAG_DATABASE_PATH=runtime/knowledge.db
ZGLAB_RAG_BACKUP_DIR=runtime/backups
ZGLAB_RAG_BACKUP_RETAIN_COUNT=7
ZGLAB_RAG_SOURCES_CONFIG=config/sources.yaml
# Explicitly registered Git sources with acquisition metadata are cloned here.
# No URL or credential belongs in sources.yaml; Git credential helpers / SSH
# deploy keys may supply authentication outside the application configuration.
ZGLAB_RAG_SOURCE_CHECKOUT_ROOT=runtime/sources

# Public retrieval is the only supported mode in v0/v1.
ZGLAB_RAG_DEFAULT_VISIBILITY=public

# Markdown chunking (character-equivalent length)
ZGLAB_RAG_CHUNK_TARGET_SIZE=700
ZGLAB_RAG_CHUNK_MAX_SIZE=1200
ZGLAB_RAG_CHUNK_OVERLAP=120

# LLM provider for grounded generation (OpenAI-compatible endpoint).
# Keep real secrets in .env only; never commit them.
ZGLAB_RAG_LLM_BASE_URL=
ZGLAB_RAG_LLM_API_KEY=
ZGLAB_RAG_LLM_MODEL=
ZGLAB_RAG_LLM_TIMEOUT_SECONDS=60

# Grounded generation context budget
ZGLAB_RAG_GENERATION_RETRIEVAL_TOP_K=5
ZGLAB_RAG_GENERATION_MAX_EVIDENCE_ITEMS=5
ZGLAB_RAG_GENERATION_MAX_CONTEXT_CHARS=6000

# Phase 15C Conversation Context Compression. Summary remains OFF by default:
# enabling it adds bounded asynchronous LLM cost after completed assistant turns.
ZGLAB_RAG_CONVERSATION_DATABASE_PATH=runtime/conversation.db
ZGLAB_RAG_CONVERSATION_CONTEXT_MAX_TURNS=4
ZGLAB_RAG_CONVERSATION_CONTEXT_MAX_CHARS=6000
ZGLAB_RAG_CONVERSATION_CONTEXT_MAX_MESSAGE_CHARS=2000
ZGLAB_RAG_CONVERSATION_CONTEXT_MAX_BYTES=18000
ZGLAB_RAG_CONVERSATION_CONTEXT_RELEVANT_TURNS=2
ZGLAB_RAG_CONVERSATION_CONTEXT_RELEVANT_MAX_CHARS=1200
ZGLAB_RAG_CONVERSATION_CONTEXT_HISTORY_SCAN_MESSAGES=160
ZGLAB_RAG_CONVERSATION_CONTEXT_RETRIEVAL_QUERY_MAX_CHARS=3000
ZGLAB_RAG_CONVERSATION_CONTEXT_RETRIEVAL_QUERY_MAX_BYTES=9000
ZGLAB_RAG_CONVERSATION_SUMMARY_ENABLED=false
ZGLAB_RAG_CONVERSATION_SUMMARY_TRIGGER_NEW_TURNS=4
ZGLAB_RAG_CONVERSATION_SUMMARY_MAX_BATCH_TURNS=8
ZGLAB_RAG_CONVERSATION_SUMMARY_SOURCE_MAX_CHARS=12000
ZGLAB_RAG_CONVERSATION_SUMMARY_SOURCE_MAX_BYTES=36000
ZGLAB_RAG_CONVERSATION_SUMMARY_MAX_CHARS=1600

# Phase 9A Public API configuration
ZGLAB_RAG_API_QUESTION_MIN_LENGTH=1
ZGLAB_RAG_API_QUESTION_MAX_LENGTH=1000
ZGLAB_RAG_API_REQUEST_TIMEOUT_SECONDS=90
ZGLAB_RAG_API_MAX_CONCURRENT_REQUESTS=1
ZGLAB_RAG_API_RATE_LIMIT_REQUESTS=10
ZGLAB_RAG_API_RATE_LIMIT_WINDOW_SECONDS=60
ZGLAB_RAG_API_MAX_REQUEST_BODY_BYTES=16384
# CORS origins as JSON array; production domain to be set in Phase 10
ZGLAB_RAG_API_CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
ZGLAB_RAG_API_TRUSTED_PROXY_IPS=["127.0.0.1","::1"]
# Phase 9B: SSE heartbeat interval (seconds)
ZGLAB_RAG_API_SSE_HEARTBEAT_SECONDS=15

# Localhost-only embedding API. Generate a high-entropy secret; never commit it.
INTERNAL_EMBEDDING_TOKEN=
ZGLAB_RAG_INTERNAL_EMBEDDING_TIMEOUT_SECONDS=15
ZGLAB_RAG_INTERNAL_EMBEDDING_MAX_TEXTS=64
ZGLAB_RAG_INTERNAL_EMBEDDING_MAX_TEXT_CHARS=8000
ZGLAB_RAG_INTERNAL_EMBEDDING_MAX_REQUEST_BODY_BYTES=524288
# Phase 11: retire anonymous v1 ask endpoints (production migration flips this)
ZGLAB_RAG_API_V1_RETIRED=false

# Phase 11 Authentication & Access Control
ZGLAB_RAG_AUTH_DATABASE_PATH=runtime/auth.db
ZGLAB_RAG_AUTH_PUBLIC_BASE_URL=http://localhost:8000
# 本地纯 HTTP 开发时 Secure/__Host- cookie 无法写入浏览器，可改为：
#   ZGLAB_RAG_AUTH_COOKIE_NAME=zglab_session_dev
#   ZGLAB_RAG_AUTH_COOKIE_SECURE=false
# 生产 HTTPS 必须保持 __Host-zglab_session + true。
ZGLAB_RAG_AUTH_COOKIE_NAME=__Host-zglab_session
ZGLAB_RAG_AUTH_COOKIE_SECURE=true
ZGLAB_RAG_LLM_ENABLED=true

# Embedding / reranker selection is intentionally not frozen in v0.
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
RERANKER_PROVIDER=
RERANKER_MODEL=

# Phase 12B Web Research Core. Fail-closed default: disabled until the
# Phase 12D product acceptance. The Search API key only ever comes from
# environment — never code, tests, docs or logs.
ZGLAB_RAG_WEB_RESEARCH_ENABLED=false
ZGLAB_RAG_SEARCH_PROVIDER=tavily
ZGLAB_RAG_SEARCH_API_KEY=

# Phase 12D product cost boundary: independent web-research quota bucket,
# conservative concurrency and the server-side permission policy.
ZGLAB_RAG_WEB_RESEARCH_REQUESTS_PER_MINUTE=3
ZGLAB_RAG_WEB_RESEARCH_REQUESTS_PER_DAY=20
ZGLAB_RAG_WEB_RESEARCH_CONCURRENCY=1
ZGLAB_RAG_WEB_RESEARCH_ADMIN_ONLY=false

# Phase 13C MCP Tool Runtime (host side). Fail-closed default: disabled.
# command/args/cwd are owner deployment configuration (never user input); the
# child process receives only a minimal, secret-free environment.
ZGLAB_RAG_MCP_ENABLED=false
ZGLAB_RAG_MCP_SERVER_COMMAND=node
ZGLAB_RAG_MCP_SERVER_ARGS=["dist-mcp/cli.js"]
# ZGLAB_RAG_MCP_SERVER_CWD=/path/to/zglab-tools
ZGLAB_RAG_MCP_EXPECTED_SERVER_NAME=zglab-tools-mcp
ZGLAB_RAG_MCP_STARTUP_TIMEOUT_SECONDS=10
ZGLAB_RAG_MCP_CALL_TIMEOUT_SECONDS=2
ZGLAB_RAG_MCP_SHUTDOWN_TIMEOUT_SECONDS=5
ZGLAB_RAG_MCP_MAX_REQUEST_BYTES=262144
ZGLAB_RAG_MCP_MAX_RESPONSE_BYTES=262144
ZGLAB_RAG_MCP_MAX_CONCURRENT_CALLS=1

# Phase 14D Agent product boundary. Keep disabled until production smoke.
ZGLAB_RAG_AGENT_ENABLED=false
ZGLAB_RAG_AGENT_REQUESTS_PER_MINUTE=2
ZGLAB_RAG_AGENT_REQUESTS_PER_DAY=10
ZGLAB_RAG_AGENT_CONCURRENCY=1
ZGLAB_RAG_AGENT_OVERALL_DEADLINE_SECONDS=60
